# Copy to .env and fill in. All optional.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
X_BEARER_TOKEN=
# AI supervisor for the open trade (needs ANTHROPIC_API_KEY)
SUPERVISOR_MODEL=claude-opus-5-5
GUARD_STOP_PCT=1.0
# SEC blocks anonymous requests: your name and email
SEC_UA=
# Open-session backtest
BT_DAYS=200
BT_FEE_PCT=0.10
BT_EVENT_PCT=2.5
# BT_EVENTS=2026-11-03   # extra event dates, e.g. the morning after earnings
# ORB trader: password for the trade endpoints (required to trade from another device or on Render)
TRADE_TOKEN=
# Optional: exchange keys from the environment instead of the panel (trade-only, no withdrawals)
# EXCHANGE_ID=bybit
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
